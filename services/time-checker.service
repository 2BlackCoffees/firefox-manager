[Unit]
Description=Time Range Checker Continuous Service
# The Handshake requires both to be active
After=network-online.target ff-poller-gate.service
Requires=ff-poller-gate.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/time-checker-shutdown.py
# 'always' ensures it restarts if it crashes, is killed, or exits normally
Restart=always
RestartSec=5s

# Security hardening (Removed PrivateTmp=true to ensure /tmp/time_checker_extension is accessible)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# IMPORTANT: Python needs Write access to /tmp to create /run/time_checker_sync.request
ReadWritePaths=/tmp /var/tmp /etc/time_checker /run

# Logging and Environment
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"
SyslogIdentifier=time-checker

[Install]
WantedBy=multi-user.target

